{
  "name": "dsh-work-summary",
  "version": "0.3.1",
  "description": "Daily, weekly and monthly work reports for DeepSeek Harness: collect traces, write and validate reports, push next actions onto the board.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruochen361/dsh-work-summary.git"
  },
  "homepage": "https://github.com/ruochen361/dsh-work-summary#readme",
  "bugs": {
    "url": "https://github.com/ruochen361/dsh-work-summary/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "scripts",
    "PROMPT.md",
    "README.md",
    "locale/*.json",
    "docs/DETAIL.md",
    "icon.svg",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "daily-report",
    "work-summary",
    "journal",
    "productivity"
  ],
  "engines": {
    "dsh": ">=0.2.3-alpha.2"
  },
  "scripts": {
    "test": "node test/stats.test.mjs && node test/board-start.test.mjs && node test/route.test.mjs && node test/period.test.mjs && node test/quality.test.mjs && node test/archive.test.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "license": "MIT"
}
